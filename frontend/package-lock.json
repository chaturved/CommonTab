{
  "name": "commontab",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "commontab",
      "workspaces": [
        "packages/*",
        "apps/*"
      ]
    },
    "apps/app": {
      "name": "@commontab/app",
      "version": "0.0.0"
    },
    "node_modules/@commontab/app": {
      "resolved": "apps/app",
      "link": true
    },
    "node_modules/@commontab/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@commontab/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/core": {
      "name": "@commontab/core",
      "version": "0.0.0"
    },
    "packages/ui": {
      "name": "@commontab/ui",
      "version": "0.0.0"
    }
  }
}
